{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mqtt": {
    "Host": "mqtt.pskreporter.info",
    "Port": 1883,
    "Topic": "pskr/filter/v2/+/+/+/+/+/+/+/+"
  },
  "Cache": {
    "SweepIntervalMinutes": 5
  },
  "Stats": {
    "Enabled": false,
    "RefreshIntervalSeconds": 30,
    "ActiveWindowMinutes": 10
  },
  "Backup": {
    "Enabled": true,
    "IntervalHours": 6
  }
}