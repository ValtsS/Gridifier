# Runtime config for the Docker container. Loaded via: docker run --env-file .gridifier.env
# Env var names map to appsettings.json paths: Section__Key (e.g. Mqtt__Topic -> "Mqtt": { "Topic" })

ConnectionStrings__Gridifier=Data Source=/data/gridifier.db
Mqtt__Topic=pskr/filter/v2/+/+/+/+/+/+/+
ASPNETCORE_URLS=http://+:2080
